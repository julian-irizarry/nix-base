+/// Local patch: `[ui.sprites]`, named animations for `sprite:<name>` tokens.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(transparent)]
+pub struct SpritesConfig(pub BTreeMap<String, SpriteConfig>);
+
+impl SpritesConfig {
+    pub fn diagnostics(&self) -> Vec<String> {
+        self.0
+            .iter()
+            .filter_map(|(name, sprite)| {
+                let problem = if crate::config::sidebar::is_custom_token_name(name) {
+                    sprite.problem()?
+                } else {
+                    "names use letters, digits, `_` or `-`, up to 32".into()
+                };
+                Some(format!(
+                    "ui.sprites.{name}: {problem}; sprite:{name} tokens are left out"
+                ))
+            })
+            .collect()
+    }
+}
