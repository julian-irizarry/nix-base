+        border = fg(p.surface_dim);
+        /// Section dividers.
+        divider = fg(p.surface_dim);
+        /// `spaces`, `agents`, `machines` headers and the sort label.
+        header = fg(p.overlay0).add_modifier(Modifier::BOLD);
+        /// Active agent view label.
+        header_accent = fg(p.accent).add_modifier(Modifier::BOLD);
+        /// `new`, `menu`, and collapse toggles.
+        footer = fg(p.overlay0);
+        /// `● menu` when a menu entry needs attention (machines sidebar).
+        footer_attention = fg(p.accent);
+        /// `●` attention badge.
+        badge = fg(p.accent).add_modifier(Modifier::BOLD);
+        /// Focused workspace or agent row.
+        row_active = bg(p.active_row_bg);
