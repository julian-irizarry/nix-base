+#[test]
+fn agent_rows_draw_sprites_per_agent_and_drop_unknown_ones() {
+    let mut projected = snapshot();
+    let mut second_pane = projected.panes[0].clone();
+    second_pane.pane_id = "pane_2".into();
+    second_pane.focused = false;
+    projected.panes.push(second_pane);
+    let agent = |pane: &str, name: &str, kind: &str, status| ClientShellAgent {
+        pane_id: pane.into(),
+        workspace_id: "ws_1".into(),
+        tab_id: "tab_1".into(),
+        name: Some(name.into()),
+        display_agent: None,
+        agent: Some(kind.into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: status,
+        state_change_seq: 1,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused: false,
+    };
+    projected.agents = vec![
+        agent("pane_1", "crabby", "claude", AgentStatus::Idle),
+        agent("pane_2", "nobot", "pi", AgentStatus::Idle),
+    ];
+    let mut config = Config::default();
+    config.ui.sprites = sprites(
+        r##"
+[crab]
+idle = ["⢾⡷"]
+"##,
+    );
+    config.ui.sidebar.agents.rows = vec![vec![
+        crate::config::AgentSidebarToken::Sprite("robot".into()),
+        crate::config::AgentSidebarToken::Agent,
+    ]];
+    config.ui.sidebar.agents.rows_by_agent.insert(
+        "claude".into(),
+        vec![vec![
+            crate::config::AgentSidebarToken::Sprite("crab".into()),
+            crate::config::AgentSidebarToken::Agent,
+        ]],
+    );
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+
+    let frame = state.compose(106, 30).expect("agent sidebar frame");
+    let lines = frame
+        .cells
+        .chunks(frame.width as usize)
+        .map(|row| {
+            row.iter()
+                .map(|cell| cell.symbol.as_str())
+                .collect::<String>()
+        })
+        .collect::<Vec<_>>();
+    let text = lines.join("\n");
+    assert!(text.contains("⢾⡷ crabby"), "claude gets the crab: {text}");
+    let nobot = lines
+        .iter()
+        .find(|line| line.contains("nobot"))
+        .expect("pi row");
+    assert!(
+        nobot.trim_start().starts_with("nobot"),
