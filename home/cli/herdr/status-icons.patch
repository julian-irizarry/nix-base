+/// Local patch: kind of a `[ui.status_icons]` entry.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum StatusIconKind {
+    /// A fixed glyph from `icon`.
+    #[default]
+    Symbol,
+    /// An animated spinner stepping through `frames`.
+    Spinner,
+}
+
+/// Braille frames used when a spinner entry sets no `frames`.
+pub const DEFAULT_SPINNER_FRAMES: [&str; 10] = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
+
+/// Local patch: one agent state's icon in `[ui.status_icons]`.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(default)]
+pub struct StatusIconConfig {
+    #[serde(rename = "type")]
+    pub kind: StatusIconKind,
+    /// Glyph for `symbol`, exactly one terminal cell wide.
+    pub icon: Option<String>,
+    /// Frames for `spinner`, each one cell wide. Unset uses `DEFAULT_SPINNER_FRAMES`.
+    pub frames: Option<Vec<String>>,
+    /// `#RGB` or `#RRGGBB`. Unset uses the theme's state color.
+    pub color: Option<String>,
+}
+
+impl StatusIconConfig {
+    fn is_one_cell(value: &str) -> bool {
+        !value.chars().any(char::is_control) && unicode_width::UnicodeWidthStr::width(value) == 1
+    }
+
+    /// Why this entry can't be used, if it can't.
+    pub fn problem(&self) -> Option<String> {
+        match self.kind {
+            StatusIconKind::Symbol => match self.icon.as_deref() {
+                None => return Some("type \"symbol\" needs an icon".into()),
+                Some(icon) if !Self::is_one_cell(icon) => {
+                    return Some(format!("icon {icon:?} must be one terminal cell wide"))
+                }
+                Some(_) => {}
+            },
+            StatusIconKind::Spinner => {
+                if let Some(frames) = &self.frames {
+                    if frames.is_empty() {
+                        return Some("frames must not be empty".into());
+                    }
+                    if let Some(frame) = frames.iter().find(|frame| !Self::is_one_cell(frame)) {
+                        return Some(format!("frame {frame:?} must be one terminal cell wide"));
+                    }
+                }
+            }
+        }
+        self.color
+            .as_deref()
+            .filter(|color| crate::config::sidebar::SidebarTokenColor::parse(color).is_none())
+            .map(|color| format!("color {color:?} must be #RGB or #RRGGBB"))
+    }
+}
+
+/// Local patch: per-state agent status icons layered over `status_indicators`.
+/// Unset or invalid states keep the preset's glyph and the theme's color.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(default)]
+pub struct StatusIconsConfig {
+    pub blocked: Option<StatusIconConfig>,
+    pub working: Option<StatusIconConfig>,
+    pub done: Option<StatusIconConfig>,
+    pub idle: Option<StatusIconConfig>,
+    pub unknown: Option<StatusIconConfig>,
+}
+
+impl StatusIconsConfig {
+    pub fn diagnostics(&self) -> Vec<String> {
+        [
+            ("blocked", &self.blocked),
+            ("working", &self.working),
+            ("done", &self.done),
+            ("idle", &self.idle),
+            ("unknown", &self.unknown),
+        ]
+        .into_iter()
+        .filter_map(|(state, entry)| {
+            let problem = entry.as_ref()?.problem()?;
+            Some(format!(
+                "ui.status_icons.{state}: {problem}; using the status_indicators icon"
+            ))
+        })
+        .collect()
+    }
+}
+
