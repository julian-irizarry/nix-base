+/// Local patch: `[ui.status_icons]` resolved once per config load, so a render
+/// only indexes it. Invalid entries are dropped here (config check reports them).
+#[derive(Default)]
+pub(super) struct StatusIcons([Option<StatusIcon>; 5]);
+
+pub(super) struct StatusIcon {
+    glyph: StatusIconGlyph,
+    color: Option<ratatui::style::Color>,
+}
+
+enum StatusIconGlyph {
+    Symbol(String),
+    Spinner(Vec<String>),
+}
+
+impl StatusIcons {
+    fn slot(status: crate::api::schema::AgentStatus) -> usize {
+        use crate::api::schema::AgentStatus;
+        match status {
+            AgentStatus::Blocked => 0,
+            AgentStatus::Working => 1,
+            AgentStatus::Done => 2,
+            AgentStatus::Idle => 3,
+            AgentStatus::Unknown => 4,
+        }
+    }
+
+    pub(super) fn from_config(config: &crate::config::StatusIconsConfig) -> Self {
+        let resolve = |entry: &Option<crate::config::StatusIconConfig>| {
+            let entry = entry.as_ref().filter(|entry| entry.problem().is_none())?;
+            let glyph = match entry.kind {
+                crate::config::StatusIconKind::Symbol => {
+                    StatusIconGlyph::Symbol(entry.icon.clone()?)
+                }
+                crate::config::StatusIconKind::Spinner => {
+                    StatusIconGlyph::Spinner(entry.frames.clone().unwrap_or_else(|| {
+                        crate::config::DEFAULT_SPINNER_FRAMES
+                            .map(str::to_owned)
+                            .to_vec()
+                    }))
+                }
+            };
+            let color = entry
+                .color
+                .as_deref()
+                .and_then(crate::config::SidebarTokenColor::parse)
+                .map(crate::config::SidebarTokenColor::ratatui);
+            Some(StatusIcon { glyph, color })
+        };
+        Self([
+            resolve(&config.blocked),
+            resolve(&config.working),
+            resolve(&config.done),
+            resolve(&config.idle),
+            resolve(&config.unknown),
+        ])
+    }
+
+    fn get(&self, status: crate::api::schema::AgentStatus) -> Option<&StatusIcon> {
+        self.0[Self::slot(status)].as_ref()
+    }
+}
+
+impl ClientShellConfig {
+    /// Local patch: whether `[ui.status_icons]` sets this state.
+    fn has_status_icon_override(&self, status: crate::api::schema::AgentStatus) -> bool {
+        self.status_icons.get(status).is_some()
+    }
+
+    /// Local patch: the `[ui.status_icons]` glyph, else the preset's.
+    fn status_icon(&self, status: crate::api::schema::AgentStatus) -> &str {
+        match self.status_icons.get(status).map(|icon| &icon.glyph) {
+            Some(StatusIconGlyph::Symbol(icon)) => icon,
+            Some(StatusIconGlyph::Spinner(frames)) => spinner::draw(frames),
+            None => preset_status_icon(status, self.status_indicators),
+        }
+    }
+
+    /// Local patch: agent toasts use the `[ui.status_icons]` icon for their state
+    /// (needs attention is blocked, finished is done) when one is set, and the
+    /// stock dot otherwise.
+    fn notification_marker(&self, kind: SemanticNotificationKind) -> (&str, ratatui::style::Color) {
+        use crate::api::schema::AgentStatus;
+        let status = match kind {
+            SemanticNotificationKind::NeedsAttention => Some(AgentStatus::Blocked),
+            SemanticNotificationKind::Finished => Some(AgentStatus::Done),
+            SemanticNotificationKind::UpdateInstalled | SemanticNotificationKind::Custom => None,
+        };
+        match status.filter(|status| self.has_status_icon_override(*status)) {
+            Some(status) => (self.status_icon(status), self.status_icon_color(status)),
+            None => notifications::default_notification_marker(kind, &self.palette),
+        }
+    }
+
+    /// Local patch: the `[ui.status_icons]` color, else the theme's state color.
+    fn status_icon_color(&self, status: crate::api::schema::AgentStatus) -> ratatui::style::Color {
+        self.status_icons
+            .get(status)
+            .and_then(|icon| icon.color)
+            .unwrap_or_else(|| status_color(status, &self.palette))
+    }
+}
+
+/// Local patch: spinner for `[ui.status_icons]` entries with `type = "spinner"`.
+/// Animated by the client alone: each compose pins one frame index from the
+/// clock, and the client loop repaints only while the last composed frame drew
+/// a spinner and the clock has moved on. Nothing crosses the server protocol,
+/// and the blit encoder diffs frames, so a tick writes just the changed icon
+/// cells. Process-wide atomics rather than thread-locals because the client
+/// loop is an async task that may hop threads.
+pub(crate) mod spinner {
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+    use std::sync::OnceLock;
+    use std::time::{Duration, Instant};
+
+    const INTERVAL: Duration = Duration::from_millis(100);
+
+    static EPOCH: OnceLock<Instant> = OnceLock::new();
+    static FRAME: AtomicU64 = AtomicU64::new(0);
+    static DRAWN: AtomicBool = AtomicBool::new(false);
+
+    fn index_at(now: Instant) -> u64 {
+        let epoch = *EPOCH.get_or_init(|| now);
+        (now.saturating_duration_since(epoch).as_millis() / INTERVAL.as_millis()) as u64
+    }
+
+    /// Start a compose. Every spinner drawn until the next call shows this frame.
+    pub(crate) fn begin(now: Instant) {
+        FRAME.store(index_at(now), Ordering::Relaxed);
+        DRAWN.store(false, Ordering::Relaxed);
+    }
+
+    pub(super) fn draw(frames: &[String]) -> &str {
+        DRAWN.store(true, Ordering::Relaxed);
+        &frames[(FRAME.load(Ordering::Relaxed) % frames.len() as u64) as usize]
+    }
+
+    /// Whether the last compose drew a spinner that is now showing a stale frame.
+    pub(crate) fn due(now: Instant) -> bool {
+        DRAWN.load(Ordering::Relaxed) && index_at(now) != FRAME.load(Ordering::Relaxed)
+    }
+
+    /// Time until the next frame while a spinner is on screen.
+    pub(crate) fn next_frame_in(now: Instant) -> Option<Duration> {
+        if !DRAWN.load(Ordering::Relaxed) {
+            return None;
+        }
+        let next = (FRAME.load(Ordering::Relaxed) + 1) as u32;
+        let epoch = *EPOCH.get_or_init(|| now);
+        Some((epoch + INTERVAL * next).saturating_duration_since(now))
+    }
+}
