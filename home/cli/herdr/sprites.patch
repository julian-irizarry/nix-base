+/// Local patch: `[ui.sprites]` resolved once per config load. Sprites with a
+/// problem are dropped here (config check reports them).
+#[derive(Default)]
+pub(super) struct Sprites(std::collections::HashMap<String, Sprite>);
+
+pub(super) struct Sprite {
+    interval_ms: u64,
+    /// Per state, indexed like `StatusIcons::slot`, already falling back to `color`.
+    colors: [Option<ratatui::style::Color>; 5],
+    /// Per state, indexed like `StatusIcons::slot`.
+    frames: [Option<Vec<String>>; 5],
+}
+
+impl Sprites {
+    pub(super) fn from_config(config: &crate::config::SpritesConfig) -> Self {
+        Self(
+            config
+                .0
+                .iter()
+                .filter(|(_, sprite)| sprite.problem().is_none())
+                .map(|(name, sprite)| {
+                    let parse = |color: Option<&String>| {
+                        color
+                            .and_then(|color| crate::config::SidebarTokenColor::parse(color))
+                            .map(crate::config::SidebarTokenColor::ratatui)
+                    };
+                    let color = parse(sprite.color.as_ref());
+                    let colors = sprite
+                        .colors
+                        .states()
+                        .map(|(_, state)| parse(state).or(color));
+                    let frames = [
+                        sprite.blocked.clone(),
+                        sprite.working.clone(),
+                        sprite.done.clone(),
+                        sprite.idle.clone(),
+                        sprite.unknown.clone(),
+                    ];
+                    let interval_ms = sprite.interval_ms();
+                    (
+                        name.clone(),
+                        Sprite {
+                            interval_ms,
+                            colors,
+                            frames,
+                        },
+                    )
+                })
+                .collect(),
+        )
+    }
+}
