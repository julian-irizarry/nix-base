@@ -0,0 +1,644 @@
+//! Local patch: `[theme.elements]`, named style slots between the palette and
+//! rendering. Each slot's default is exactly what stock herdr draws, written in
+//! palette tokens (and in terms of earlier slots, like neovim highlight links),
+//! so an empty `[theme.elements]` renders identically and theme switches keep
+//! working. A config entry overrides individual fields of one slot.
+//!
+//! ```toml
+//! [theme.elements.tab]
+//! active = { fg = "text", bg = "#222222" }
+//!
+//! [theme.elements.popup]
+//! body = { bg = "reset" }
+//! ```
+
+use ratatui::style::{Color, Modifier, Style};
+use serde::{Deserialize, Serialize};
+
+use crate::app::state::Palette;
+
+/// Palette token names accepted as element colors, in `[theme.custom]` order.
+pub(crate) const PALETTE_TOKENS: [&str; 19] = [
+    "accent",
+    "panel_bg",
+    "sidebar_bg",
+    "active_row_bg",
+    "selection_bg",
+    "surface0",
+    "surface1",
+    "surface_dim",
+    "overlay0",
+    "overlay1",
+    "text",
+    "subtext0",
+    "mauve",
+    "green",
+    "yellow",
+    "red",
+    "blue",
+    "teal",
+    "peach",
+];
+
+fn palette_token(palette: &Palette, name: &str) -> Option<Color> {
+    Some(match name {
+        "accent" => palette.accent,
+        "panel_bg" => palette.panel_bg,
+        "sidebar_bg" => palette.sidebar_bg,
+        "active_row_bg" => palette.active_row_bg,
+        "selection_bg" => palette.selection_bg,
+        "surface0" => palette.surface0,
+        "surface1" => palette.surface1,
+        "surface_dim" => palette.surface_dim,
+        "overlay0" => palette.overlay0,
+        "overlay1" => palette.overlay1,
+        "text" => palette.text,
+        "subtext0" => palette.subtext0,
+        "mauve" => palette.mauve,
+        "green" => palette.green,
+        "yellow" => palette.yellow,
+        "red" => palette.red,
+        "blue" => palette.blue,
+        "teal" => palette.teal,
+        "peach" => palette.peach,
+        _ => return None,
+    })
+}
+
+/// One color value in an element style.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum ElementColor {
+    /// A palette token, resolved against the active theme.
+    Token(&'static str),
+    Rgb(crate::config::SidebarTokenColor),
+    /// The terminal's default color.
+    Reset,
+    /// No color of its own; whatever is underneath shows through.
+    Inherit,
+}
+
+impl ElementColor {
+    pub(crate) fn parse(value: &str) -> Option<Self> {
+        match value {
+            "reset" => Some(Self::Reset),
+            "inherit" => Some(Self::Inherit),
+            _ if value.starts_with('#') => {
+                crate::config::SidebarTokenColor::parse(value).map(Self::Rgb)
+            }
+            _ => PALETTE_TOKENS
+                .iter()
+                .find(|token| **token == value)
+                .map(|token| Self::Token(token)),
+        }
+    }
+
+    fn resolve(self, palette: &Palette) -> Option<Color> {
+        match self {
+            Self::Token(name) => palette_token(palette, name),
+            Self::Rgb(color) => Some(color.ratatui()),
+            Self::Reset => Some(Color::Reset),
+            Self::Inherit => None,
+        }
+    }
+}
+
+/// Style overrides for one element slot. Unset fields keep the slot's default.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(default)]
+pub struct ElementStyleConfig {
+    /// Palette token, `#RGB` / `#RRGGBB`, `"reset"`, or `"inherit"`.
+    pub fg: Option<String>,
+    /// Same values as `fg`.
+    pub bg: Option<String>,
+    pub bold: Option<bool>,
+    pub dim: Option<bool>,
+    pub italic: Option<bool>,
+    pub underline: Option<bool>,
+}
+
+impl ElementStyleConfig {
+    /// Problems with this style, each naming the field under `key`.
+    pub(crate) fn diagnostics(&self, key: &str) -> Vec<String> {
+        [("fg", &self.fg), ("bg", &self.bg)]
+            .into_iter()
+            .filter_map(|(field, value)| {
+                let value = value.as_deref()?;
+                ElementColor::parse(value).is_none().then(|| {
+                    format!(
+                        "{key}.{field} = {value:?} must be a palette token, #RGB, #RRGGBB, \"reset\", or \"inherit\"; using the default"
+                    )
+                })
+            })
+            .collect()
+    }
+
+    /// `base` with this style's valid fields applied. Invalid colors keep the base.
+    pub(crate) fn apply(&self, base: Style, palette: &Palette) -> Style {
+        let mut style = base;
+        let color = |value: &Option<String>| {
+            value
+                .as_deref()
+                .and_then(ElementColor::parse)
+                .map(|color| color.resolve(palette))
+        };
+        if let Some(fg) = color(&self.fg) {
+            style.fg = fg;
+        }
+        if let Some(bg) = color(&self.bg) {
+            style.bg = bg;
+        }
+        for (flag, modifier) in [
+            (self.bold, Modifier::BOLD),
+            (self.dim, Modifier::DIM),
+            (self.italic, Modifier::ITALIC),
+            (self.underline, Modifier::UNDERLINED),
+        ] {
+            match flag {
+                Some(true) => {
+                    style.add_modifier.insert(modifier);
+                    style.sub_modifier.remove(modifier);
+                }
+                Some(false) => {
+                    style.add_modifier.remove(modifier);
+                    style.sub_modifier.insert(modifier);
+                }
+                None => {}
+            }
+        }
+        style
+    }
+}
+
+fn resolve_slot(config: Option<&ElementStyleConfig>, default: Style, palette: &Palette) -> Style {
+    config.map_or(default, |config| config.apply(default, palette))
+}
+
+fn fg(color: Color) -> Style {
+    Style::default().fg(color)
+}
+
+fn bg(color: Color) -> Style {
+    Style::default().bg(color)
+}
+
+/// Text color for a filled pill drawn over `base`: its background, or
+/// `surface_dim` when that is the terminal default.
+fn contrast(base: Style, palette: &Palette) -> Color {
+    match base.bg {
+        Some(Color::Reset) | None => palette.surface_dim,
+        Some(color) => color,
+    }
+}
+
+fn first_set(color: Color, fallback: Color) -> Color {
+    if color == Color::Reset {
+        fallback
+    } else {
+        color
+    }
+}
+
+/// Declares every area and slot once. Generates the per-area config tables,
+/// the resolved structs of ratatui styles, resolution, and diagnostics. Slot
+/// defaults may name the palette (`$p`), earlier slots in the same area, and
+/// earlier areas.
+macro_rules! theme_elements {
+    (
+        |$p:ident|
+        $(
+            $(#[$area_doc:meta])*
+            $area:ident : $Resolved:ident / $Config:ident {
+                $(
+                    $(#[$slot_doc:meta])*
+                    $slot:ident = $default:expr;
+                )*
+            }
+        )*
+    ) => {
+        $(
+            $(#[$area_doc])*
+            #[derive(Debug, Clone, Default, PartialEq, Eq, Deserialize, Serialize)]
+            #[serde(default)]
+            pub struct $Config {
+                $(
+                    $(#[$slot_doc])*
+                    pub $slot: Option<ElementStyleConfig>,
+                )*
+            }
+
+            $(#[$area_doc])*
+            #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+            pub struct $Resolved {
+                $(
+                    $(#[$slot_doc])*
+                    pub $slot: Style,
+                )*
+            }
+        )*
+
+        /// `[theme.elements]`, one table per area.
+        #[derive(Debug, Clone, Default, PartialEq, Eq, Deserialize, Serialize)]
+        #[serde(default)]
+        pub struct ThemeElementsConfig {
+            $( pub $area: $Config, )*
+        }
+
+        /// Every element slot resolved against one palette.
+        #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+        pub struct ThemeElements {
+            $( pub $area: $Resolved, )*
+        }
+
+        impl ThemeElements {
+            pub fn resolve(config: &ThemeElementsConfig, palette: &Palette) -> Self {
+                let $p = palette;
+                $(
+                    let $area = {
+                        $(
+                            let $slot = resolve_slot(config.$area.$slot.as_ref(), $default, $p);
+                        )*
+                        $Resolved { $( $slot, )* }
+                    };
+                )*
+                Self { $( $area, )* }
+            }
+        }
+
+        impl ThemeElementsConfig {
+            pub(crate) fn diagnostics(&self) -> Vec<String> {
+                let mut diagnostics = Vec::new();
+                $( $(
+                    if let Some(style) = &self.$area.$slot {
+                        diagnostics.extend(style.diagnostics(concat!(
+                            "theme.elements.",
+                            stringify!($area),
+                            ".",
+                            stringify!($slot)
+                        )));
+                    }
+                )* )*
+                diagnostics
+            }
+        }
+    };
+}
+
+theme_elements! {
+    |p|
+
+    /// Tab bar.
+    tab: TabElements / TabElementsConfig {
+        /// Tab bar background.
+        bar = bg(p.panel_bg);
+        /// Focused tab.
+        active = fg(contrast(bar, p)).bg(p.accent);
+        /// Focused tab with a custom label.
+        active_custom = active.add_modifier(Modifier::BOLD);
+        /// Unfocused tab.
+        inactive = fg(p.overlay0).bg(p.surface0);
+        /// Unfocused tab with a custom label.
+        inactive_custom = inactive.fg(p.overlay1);
+        /// Overflow scroll button with nothing to scroll to.
+        scroll = fg(p.overlay0).bg(p.surface0);
+        /// Overflow scroll button that can scroll.
+        scroll_enabled = scroll.fg(p.overlay1);
+        /// `+` new tab button.
+        new_tab = bar.fg(p.overlay1);
+        /// `…` marks for tabs scrolled out of view.
+        overflow = fg(p.overlay0);
+        /// Drop marker while dragging a tab.
+        drop_indicator = fg(p.accent);
+        /// `tab_bar_right` segment text. Entries can override it with `style`.
+        status = bar.fg(p.overlay1);
+        /// `tab_bar_right_separator`.
+        status_separator = bar.fg(p.overlay0);
+        /// Highlighted `tab_bar_right` segment (`ZOOM`).
+        status_accent = fg(contrast(bar, p)).bg(p.accent).add_modifier(Modifier::BOLD);
+    }
+
+    /// Pane borders and scrollbars (drawn by the server).
+    pane: PaneElements / PaneElementsConfig {
+        /// Unfocused pane border.
+        border = fg(p.overlay0);
+        /// Focused pane border.
+        border_focused = fg(p.accent);
+        /// Unfocused pane border title.
+        title = border;
+        /// Focused pane border title.
+        title_focused = border_focused.add_modifier(Modifier::BOLD);
+        /// Unfocused pane scrollbar track.
+        scrollbar = fg(p.surface_dim);
+        /// Unfocused pane scrollbar thumb.
+        scrollbar_thumb = fg(p.overlay0);
+        /// Focused pane scrollbar track.
+        scrollbar_focused = fg(p.overlay0);
+        /// Focused pane scrollbar thumb.
+        scrollbar_thumb_focused = fg(p.overlay1);
+    }
+
+    /// Screen shown while the active machine is unavailable.
+    shell: ShellElements / ShellElementsConfig {
+        /// Background.
+        unavailable = fg(p.text).bg(p.panel_bg);
+        /// Status message.
+        message = fg(p.overlay0);
+    }
+
+    /// Mode hint bar (navigate, resize, copy, errors).
+    mode_bar: ModeBarElements / ModeBarElementsConfig {
+        /// Bar background and hint text.
+        bar = fg(p.overlay0).bg(p.panel_bg);
+        /// Key names.
+        key = bar.fg(p.accent).add_modifier(Modifier::BOLD);
+        /// Mode pill (`NAVIGATE`, `COPY`, `ERROR`).
+        mode = fg(contrast(bar, p)).bg(p.accent).add_modifier(Modifier::BOLD);
+        /// `RESIZE` mode pill.
+        mode_resize = mode.bg(p.mauve);
+        /// Copy-mode search input.
+        input = bar.fg(p.text);
+        /// Copy-mode search cursor.
+        cursor = fg(p.panel_bg).bg(p.text);
+        /// `update ready` notice.
+        update = key;
+    }
+
+    /// Copy mode inside panes.
+    copy: CopyElements / CopyElementsConfig {
+        /// Copy-mode cursor.
+        cursor = fg(contrast(bg(p.panel_bg), p)).bg(p.accent).add_modifier(Modifier::BOLD);
+        /// Search matches.
+        search_match = fg(p.text).bg(p.surface1);
+        /// Current search match.
+        match_current = cursor;
+    }
+
+    /// Modal popups: help, rename, confirm, settings, worktrees, release notes,
+    /// onboarding, the navigator frame, and command popups.
+    popup: PopupElements / PopupElementsConfig {
+        /// Popup fill. Most popup slots take their background from this.
+        body = bg(p.panel_bg);
+        /// Frame.
+        border = body.fg(p.accent);
+        /// Frame of destructive confirmations.
+        border_danger = body.fg(p.red);
+        /// Title.
+        title = body.fg(p.text).add_modifier(Modifier::BOLD);
+        /// Title of destructive confirmations.
+        title_danger = body.fg(p.red).add_modifier(Modifier::BOLD);
+        /// Body text.
+        text = body.fg(p.text);
+        /// Paths and details.
+        detail = body.fg(p.subtext0);
+        /// Subtitles, descriptions, and messages.
+        secondary = body.fg(p.overlay1);
+        /// Labels, placeholders, counts, and key hints.
+        muted = body.fg(p.overlay0);
+        /// Progress text and the navigator title.
+        accent = body.fg(p.accent);
+        /// Section headings and highlighted keys.
+        heading = body.fg(p.accent).add_modifier(Modifier::BOLD);
+        /// Key names in the keybind help.
+        key = body.fg(p.mauve).add_modifier(Modifier::BOLD);
+        /// Error text.
+        error = body.fg(p.red);
+        /// Horizontal rules.
+        separator = body.fg(p.surface1);
+        /// Text inputs.
+        input = fg(p.text).bg(p.surface0);
+        /// Selected list entry.
+        selected = fg(contrast(body, p)).bg(p.accent);
+        /// Primary button.
+        button = fg(contrast(body, p)).bg(p.accent).add_modifier(Modifier::BOLD);
+        /// Destructive primary button.
+        button_danger = fg(contrast(body, p)).bg(p.red).add_modifier(Modifier::BOLD);
+        /// Secondary button.
+        button_secondary = fg(p.text).bg(p.surface0).add_modifier(Modifier::BOLD);
+        /// Scrollbar track.
+        scrollbar = body.fg(p.overlay0);
+        /// Scrollbar thumb.
+        scrollbar_thumb = body.fg(p.overlay1);
+    }
+
+    /// Context menus and the global menu.
+    menu: MenuElements / MenuElementsConfig {
+        /// Menu entry.
+        item = popup.text;
+        /// Highlighted menu entry.
+        selected = popup.selected.add_modifier(Modifier::BOLD);
+        /// `●` attention badge.
+        badge = popup.heading;
+    }
+
+    /// Go-to navigator rows. The frame, search, and hints use popup slots.
+    navigator: NavigatorElements / NavigatorElementsConfig {
+        /// Agent and terminal row.
+        row = popup.body.fg(p.text);
