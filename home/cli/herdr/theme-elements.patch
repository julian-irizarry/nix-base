+        /// `close` button label.
+        close_label = button.fg(p.overlay1).add_modifier(Modifier::BOLD);
+        /// Row name, patched over the row background.
+        row = fg(p.text);
+        /// Row detail line.
+        row_detail = fg(p.overlay0);
+        /// Focused row.
+        row_focused = bg(p.surface_dim);
+        /// Selected row.
+        row_selected = bg(first_set(p.surface0, p.active_row_bg));
+        /// Rows from an unavailable machine.
+        stale = fg(p.overlay0).add_modifier(Modifier::DIM);
+        /// Scrollbar track.
+        scrollbar = header.fg(p.surface_dim);
