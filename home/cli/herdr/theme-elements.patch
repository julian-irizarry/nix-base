+        row_machine = popup.body.fg(p.subtext0);
+        /// Selected row, patched over the row. With `fg = "inherit"` the row
+        /// keeps its own text, status, and meta colors.
+        selected = fg(contrast(popup.body, p)).bg(p.accent).add_modifier(Modifier::BOLD);
+        /// Rows from an unavailable machine.
+        stale = popup.body.fg(p.overlay0).add_modifier(Modifier::DIM);
+        /// Selected row from an unavailable machine.
+        stale_selected = stale.bg(p.surface0);
+        /// Machine and workspace group rows, patched over the row.
+        group = Style::default().add_modifier(Modifier::BOLD);
+        /// `├─` tree connectors.
+        connector = fg(p.overlay0);
+        /// Agent kind and state columns.
+        meta = fg(p.overlay0);
+    }
+
+    /// Settings popup.
+    settings: SettingsElements / SettingsElementsConfig {
+        /// Section tab.
+        tab = popup.secondary;
+        /// Current section tab.
+        tab_active = popup.selected.add_modifier(Modifier::BOLD);
+        /// Rule under the section tabs.
+        rule = popup.body.fg(p.surface0);
+        /// Choice.
+        choice = popup.text;
+        /// Highlighted choice.
+        choice_selected = popup.selected.add_modifier(Modifier::BOLD);
+        /// Installed integration marker.
+        installed = popup.body.fg(p.green);
+        /// Outdated integration marker.
+        outdated = popup.body.fg(p.yellow);
+        /// Installable integration marker.
+        available = popup.body.fg(p.accent);
+        /// Missing integration marker.
+        missing = popup.body.fg(p.overlay0);
+    }
+
+    /// Release notes and announcement text.
+    markdown: MarkdownElements / MarkdownElementsConfig {
+        /// Body text.
+        text = fg(p.text);
+        /// `update ready` title.
