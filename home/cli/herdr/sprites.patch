+#[test]
+fn sprite_frame_falls_back_to_idle_and_colors_by_state() {
+    use crate::api::schema::AgentStatus;
+    let mut config = Config::default();
+    config.ui.sprites = sprites(
+        r##"
+[crab]
+working = ["⣿⣀", "⣀⣿"]
+idle = ["⠶⠶"]
+
+[robot]
+color = "#ff0000"
+colors = { blocked = "#00f" }
+done = ["⣤⣤"]
+blocked = ["⣀⣀"]
+
+[broken]
+working = ["⣿", "⣀⣀"]
+"##,
+    );
+    let shell = ClientShellConfig::from_config(&config);
+
+    let (frame, color) = shell.sprite_frame("crab", AgentStatus::Working).unwrap();
+    assert!(["⣿⣀", "⣀⣿"].contains(&frame));
+    assert_eq!(color, shell.status_icon_color(AgentStatus::Working));
+    assert_eq!(
+        shell
+            .sprite_frame("crab", AgentStatus::Blocked)
+            .map(|(f, _)| f),
+        Some("⠶⠶"),
+        "a state without frames uses idle's"
+    );
+    let red = ratatui::style::Color::Rgb(0xff, 0, 0);
+    assert_eq!(
+        shell.sprite_frame("robot", AgentStatus::Done),
+        Some(("⣤⣤", red))
+    );
+    let blue = ratatui::style::Color::Rgb(0, 0, 0xff);
+    assert_eq!(
+        shell.sprite_frame("robot", AgentStatus::Blocked),
+        Some(("⣀⣀", blue)),
+        "colors.<state> beats color"
+    );
+    assert_eq!(
+        shell.sprite_frame("robot", AgentStatus::Working),
+        None,
+        "no idle"
+    );
+    assert_eq!(
+        shell.sprite_frame("broken", AgentStatus::Working),
+        None,
+        "mixed widths"
+    );
+    assert_eq!(shell.sprite_frame("missing", AgentStatus::Working), None);
+}
