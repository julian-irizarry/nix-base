+// Local patch: color a leading process icon (as written by the tab-icons
+// plugin) the way the wezterm tabline does. The label stays plain text.
+pub(super) fn label_icon_color(icon: char) -> Option<ratatui::style::Color> {
+    use ratatui::style::Color::Rgb;
+    // Colors from the wezterm tabline (tabline.wez process icons on the
+    // "iTerm2 Pastel Dark Background" scheme, plus its nvim/ssh overrides).
+    Some(match icon {
+        '\u{2733}' => Rgb(0xe8, 0x88, 0x5c),                // claude
+        '\u{e795}' => Rgb(0xff, 0xb4, 0x73),                // zsh/bash/fish
+        '\u{e6ae}' => Rgb(0xa6, 0xe3, 0xa1),                // nvim
+        '\u{f048b}' => Rgb(0xf5, 0xc2, 0xe7),               // ssh
+        '\u{e7a8}' | '\u{f0127}' => Rgb(0xff, 0x83, 0x73),  // cargo, btop
+        '\u{e702}' => Rgb(0xff, 0xfe, 0xd5),                // git
+        '\u{f313}' | '\u{f0868}' => Rgb(0xa5, 0xd5, 0xfe),  // nix, docker
+        '\u{f07d3}' => Rgb(0xc2, 0xe3, 0xff),               // go
+        '\u{f0399}' => Rgb(0xff, 0xc4, 0xbe),               // node
+        _ => return None,
+    })
+}
+
+// Local patch: the active tab borrows selection_bg (otherwise only the
+// navigate-mode cursor row) so the sidebar's active_row_bg can differ.
+pub(super) fn tab_active_bg(palette: &Palette) -> ratatui::style::Color {
+    match palette.selection_bg {
+        ratatui::style::Color::Reset => palette.active_row_bg,
+        color => color,
+    }
+}
+
+// Local patch: Powerline caps on the active tab, drawn in its padding cells
+// so tab widths and hit areas are unchanged.
+fn draw_active_tab_caps(buffer: &mut Buffer, rect: Rect, palette: &Palette) {
+    let cap = Style::default().fg(tab_active_bg(palette)).bg(palette.panel_bg);
+    let right = rect.right().saturating_sub(1);
+    for (x, glyph) in [(rect.x, "\u{e0b2}"), (right, "\u{e0b0}")] {
+        if let Some(cell) = buffer.cell_mut((x, rect.y)) {
+            cell.set_symbol(glyph).set_style(cap);
+        }
+    }
+}
+
+fn tint_label_icon(buffer: &mut Buffer, rect: Rect, left: u16, name: &str) {
+    let Some(icon) = name.chars().next() else {
+        return;
+    };
+    let Some(color) = label_icon_color(icon) else {
+        return;
+    };
+    let x = rect.x.saturating_add(left);
+    if x < rect.right() {
+        if let Some(cell) = buffer.cell_mut((x, rect.y)) {
+            cell.set_fg(color);
+        }
+    }
