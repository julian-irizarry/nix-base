+// Local patch: `[terminal] shift_enter_csi_u`, process-wide like
+// `kitty_graphics::set_enabled` because key encoding runs below any config handle.
+static SHIFT_ENTER_CSI_U: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub(crate) fn set_shift_enter_csi_u(enabled: bool) {
+    SHIFT_ENTER_CSI_U.store(enabled, std::sync::atomic::Ordering::Release);
+}
+
+fn shift_enter_csi_u() -> bool {
+    SHIFT_ENTER_CSI_U.load(std::sync::atomic::Ordering::Acquire)
+}
