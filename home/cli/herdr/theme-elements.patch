+        /// `###` headings and the update marker.
+        heading = fg(p.accent).add_modifier(Modifier::BOLD);
+        /// List bullets.
+        bullet = fg(p.accent);
+        /// Inline code.
+        code = fg(p.accent).bg(p.surface0).add_modifier(Modifier::BOLD);
+        /// Fenced code blocks.
+        code_block = fg(p.text).bg(p.surface1);
