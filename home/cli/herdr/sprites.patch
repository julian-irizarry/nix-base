+#[serde(default)]
+pub struct SpriteConfig {
+    /// Milliseconds per frame. Unset uses `DEFAULT_SPRITE_INTERVAL_MS`.
+    pub interval_ms: Option<u64>,
+    /// `#RGB` or `#RRGGBB`. Unset uses the row's status icon color.
+    pub color: Option<String>,
+    /// Per-state colors that override `color`.
+    pub colors: SpriteColors,
+    pub blocked: Option<Vec<String>>,
+    pub working: Option<Vec<String>>,
+    pub done: Option<Vec<String>>,
+    pub idle: Option<Vec<String>>,
+    pub unknown: Option<Vec<String>>,
+}
+
+/// Local patch: `colors` in a `[ui.sprites]` entry, `#RGB` or `#RRGGBB` per state.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(default)]
+pub struct SpriteColors {
+    pub blocked: Option<String>,
+    pub working: Option<String>,
+    pub done: Option<String>,
+    pub idle: Option<String>,
+    pub unknown: Option<String>,
+}
+
+impl SpriteColors {
+    pub fn states(&self) -> [(&'static str, Option<&String>); 5] {
+        [
+            ("blocked", self.blocked.as_ref()),
+            ("working", self.working.as_ref()),
+            ("done", self.done.as_ref()),
+            ("idle", self.idle.as_ref()),
+            ("unknown", self.unknown.as_ref()),
+        ]
+    }
+}
+
+impl SpriteConfig {
+    pub fn states(&self) -> [(&'static str, Option<&Vec<String>>); 5] {
+        [
+            ("blocked", self.blocked.as_ref()),
+            ("working", self.working.as_ref()),
+            ("done", self.done.as_ref()),
+            ("idle", self.idle.as_ref()),
+            ("unknown", self.unknown.as_ref()),
+        ]
+    }
+
+    pub fn interval_ms(&self) -> u64 {
+        self.interval_ms.unwrap_or(DEFAULT_SPRITE_INTERVAL_MS)
+    }
+
+    /// Why this sprite can't be drawn, if it can't.
+    pub fn problem(&self) -> Option<String> {
+        if !SPRITE_INTERVAL_MS.contains(&self.interval_ms()) {
+            return Some(format!(
+                "interval_ms must be {}-{}",
+                SPRITE_INTERVAL_MS.start(),
+                SPRITE_INTERVAL_MS.end()
+            ));
+        }
+        let invalid =
+            |color: &&str| crate::config::sidebar::SidebarTokenColor::parse(color).is_none();
+        if let Some(color) = self.color.as_deref().filter(invalid) {
+            return Some(format!("color {color:?} must be #RGB or #RRGGBB"));
+        }
+        for (state, color) in self.colors.states() {
+            if let Some(color) = color.map(String::as_str).filter(invalid) {
+                return Some(format!("colors.{state} {color:?} must be #RGB or #RRGGBB"));
+            }
+        }
+        let mut width: Option<(usize, &str)> = None;
+        let mut any = false;
+        for (state, frames) in self.states() {
+            let Some(frames) = frames else { continue };
+            any = true;
+            if frames.is_empty() {
+                return Some(format!("{state} frames must not be empty"));
+            }
+            for frame in frames {
+                let frame_width = unicode_width::UnicodeWidthStr::width(frame.as_str());
+                if frame.chars().any(char::is_control)
+                    || !(1..=MAX_SPRITE_WIDTH).contains(&frame_width)
+                {
+                    return Some(format!(
+                        "{state} frame {frame:?} must be 1-{MAX_SPRITE_WIDTH} cells wide"
+                    ));
+                }
+                match width {
+                    None => width = Some((frame_width, state)),
+                    Some((first, first_state)) if first != frame_width => {
+                        return Some(format!(
+                            "every frame must be one width: {first_state} frames are {first} \
+                             wide, {state} frame {frame:?} is {frame_width}"
+                        ))
+                    }
+                    Some(_) => {}
+                }
+            }
+        }
+        (!any).then(|| "needs frames for at least one state".into())
+    }
+}
